    "llm-wiki-compiler": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
