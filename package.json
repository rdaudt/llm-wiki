{
  "name": "ai-industry-intelligence-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-llmwiki-openai.mjs",
